{
  "name": "@qntx/ur",
  "version": "0.1.0",
  "description": "Uniform Resources (UR) transport for JavaScript/TypeScript — Bytewords, fountain codes, and multi-part UR.",
  "keywords": [
    "blockchain-commons",
    "bytewords",
    "fountain",
    "qr",
    "uniform-resources",
    "ur"
  ],
  "homepage": "https://github.com/qntx/ur.js#readme",
  "bugs": {
    "url": "https://github.com/qntx/ur.js/issues"
  },
  "license": "MIT",
  "author": "QuantX <x@qntx.fun>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/ur.js.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "lint": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "bumpp": "^12.2.2",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "^0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
